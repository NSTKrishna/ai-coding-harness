# Copy to .env (git-ignored) or export these in your shell.
# Values already set in the environment take precedence over .env.

# Required. The only secret. Never commit a real value.
AI_API_KEY=

# Model selection. The adapter is the transport/protocol; the provider is only a
# family label for reports; AI_MODEL / AI_BASE_URL come from whoever serves the
# model. No default is built in until the organizers confirm theirs.
#
# Example (verified 2026-09-26): AWS Bedrock's OpenAI-compatible endpoint with a
# Bedrock API key (short-term keys expire after at most 12 h) in AI_API_KEY:
#   AI_MODEL_ADAPTER=openai_compatible
#   AI_MODEL_PROVIDER=qwen            # or deepseek
#   AI_MODEL=qwen.qwen3-coder-480b-a35b-instruct   # or deepseek.v3.2, qwen.qwen3-235b-a22b-2507, ...
#   AI_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
AI_MODEL_ADAPTER=
AI_MODEL_PROVIDER=
AI_MODEL=
AI_BASE_URL=

# Model transport (optional; defaults shown).
# AI_MODEL_TIMEOUT_SECONDS=120
# AI_MODEL_MAX_RETRIES=2            # transient failures only (connection, timeout, 408/409/429/5xx)
# AI_MODEL_HEADERS={}               # extra HTTP headers as a JSON object (never Authorization)
# AI_MODEL_STRUCTURED_OUTPUT=none   # or json_object (asks the endpoint for JSON mode on planner calls)

# Execution limits (optional; defaults shown).
HARNESS_MAX_STEPS=40
HARNESS_MAX_REPAIR_CYCLES=3
HARNESS_COMMAND_TIMEOUT_SECONDS=300
HARNESS_MAX_MODEL_CALLS=60
HARNESS_MAX_TOOL_CALLS=80
HARNESS_MAX_VERIFICATION_COMMANDS=3
HARNESS_MAX_REPEATED_FAILURE_CYCLES=2
HARNESS_TARGETED_TESTS=true
HARNESS_VERIFY_FULL_SUITE=true

# Working-context limits for repository discovery (optional; defaults shown).
HARNESS_MAX_ACTIVE_FILES=8
HARNESS_MAX_CANDIDATES=25
HARNESS_MAX_EVIDENCE_ITEMS=24
HARNESS_MAX_SNIPPET_LINES=30
HARNESS_MAX_CONTEXT_CHARS=24000
HARNESS_CONTEXT_COMPACTION_THRESHOLD=60000

# Run artifacts (optional).
HARNESS_TELEMETRY=true
# HARNESS_RUNS_DIR=
